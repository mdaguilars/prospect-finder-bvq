  "definiciones": {
    "fin_ratio_patrimonio_activos": {
      "formula": "patrimonio_final / activos_final",
      "regla": "Se calcula únicamente cuando activos_final > 0. El patrimonio puede ser positivo, cero o negativo."
    },
    "fin_roa": {
      "formula": "utilidad_neta_final / activos_final",
      "regla": "Se calcula únicamente cuando activos_final > 0."
    },
    "fin_margen_neto": {
      "formula": "utilidad_neta_final / bi_ingresos_ventas",
      "regla": "Se calcula únicamente cuando bi_ingresos_ventas > 0."
    },
    "fin_rotacion_activos": {
      "formula": "bi_ingresos_ventas / activos_final",
      "regla": "Se calcula únicamente cuando activos_final > 0."
    },
    "fin_roe": {
      "formula": "utilidad_neta_final / patrimonio_final",
      "regla": "Se calcula únicamente cuando patrimonio_final > 0. No se calcula ROE cuando el patrimonio es cero o negativo."
    },
    "fin_crecimiento_activos": {
      "formula": "(activos_final / activos_final_t1) - 1",
      "regla": "Se calcula únicamente cuando activos_final_t1 > 0. Si no existe t-1, el resultado permanece missing."
    },
    "fin_crecimiento_patrimonio": {
      "formula": "(patrimonio_final / patrimonio_final_t1) - 1",
      "regla": "Se calcula únicamente cuando patrimonio_final_t1 > 0. No se calcula crecimiento porcentual cuando el patrimonio anterior es cero o negativo."
    },
    "fin_crecimiento_ventas": {
      "formula": "(bi_ingresos_ventas / bi_ingresos_ventas_t1) - 1",
      "regla": "Se calcula únicamente cuando bi_ingresos_ventas_t1 > 0. Las observaciones con ventas t-1 iguales a cero permanecen missing para esta variable."
    },
    "fin_crecimiento_empleados": {
      "formula": "(bi_n_empleados / bi_n_empleados_t1) - 1",
      "regla": "Se calcula únicamente cuando bi_n_empleados_t1 > 0."
    },
    "flag_patrimonio_no_positivo": {
      "formula": "patrimonio_final <= 0",
      "regla": "TRUE cuando patrimonio_final es cero o negativo. FALSE cuando es positivo. Missing cuando patrimonio_final no está disponible."
    }
  },
